# HerbMind Agent 服务环境变量模板
# 用法：复制本文件为 .env，把 LLM_API_KEY 换成真实 key
#   cp .env.example .env
# .env 已在 .gitignore 里挡住，不会被提交
#
# ⚠️ 换变量名时同步改 app/config.py 里的字段名（pydantic-settings 按名大小写无关匹配）

# ---------- 服务 ----------
APP_PORT=8091

# ---------- 大模型（硅基流动，OpenAI 兼容协议） ----------
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------- 向量模型 ----------
# ⚠️ 必须锁死 BAAI/bge-m3：库里 content_unit.embedding 是 1024 维、
#    由该模型生成。换模型 → 向量空间不同 → 检索结果无意义（换就得全量重算）
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 数据源（对应 docker/docker-compose.infra.yml 的 herbmind-v2-*） ----------
PG_DSN=postgresql://postgres:postgres@localhost:5432/herbmind
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=herbmind123
REDIS_URL=redis://localhost:6379/0

# ---------- 跨域（前端本地开发地址，逗号分隔） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
