<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.herbmind</groupId>
    <artifactId>herbmind-backend</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>svc-search</artifactId>
  <name>HerbMind svc-search</name>

  <dependencies>
    <dependency>
      <groupId>com.herbmind</groupId>
      <artifactId>herbmind-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.herbmind</groupId>
      <artifactId>herbmind-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 检索是纯 SQL（pgvector / pg_jieba / pg_trgm），用 JdbcTemplate 比 ORM 更直接 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
